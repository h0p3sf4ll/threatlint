[Unit]
Description=Threatlint authenticated web gateway
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=threatlint-web
Group=threatlint-web
SupplementaryGroups=docker
WorkingDirectory=/opt/threatlint/current/web
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOME=/var/lib/threatlint-web
EnvironmentFile=/etc/threatlint-web/web.env
ExecStart=/usr/bin/env node /opt/threatlint/current/web/web-server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
UMask=0077
StateDirectory=threatlint-web
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/threatlint-web

[Install]
WantedBy=multi-user.target
