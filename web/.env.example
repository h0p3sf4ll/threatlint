# Public Auth0 SPA configuration. No client secret is used by this flow.
AUTH0_DOMAIN=threatlint.us.auth0.com
AUTH0_CLIENT_ID=eysUAb8yPNapU4TXqRHpIfhSX4xC4Qqy
AUTH0_AUDIENCE=https://threatlint.dev/api
THREATLINT_WEB_ORIGIN=https://app.threatlint.dev

# Advertise only providers configured and enabled for this SPA in Auth0.
# Add apple,github,sso only after their social/enterprise connections are ready.
AUTH0_ENABLED_PROVIDERS=google

# Optional overrides when social connections have different names in your tenant.
AUTH0_GOOGLE_CONNECTION=google-oauth2
AUTH0_APPLE_CONNECTION=apple
AUTH0_GITHUB_CONNECTION=github

# Optional server-only M2M credentials for organization discovery and administration.
# Authorize its Auth0 Management API scopes as described in docs/web-app.md.
# Never expose this secret to the SPA, browser, profile workers, image, or repository.
# AUTH0_MANAGEMENT_CLIENT_ID=your-server-m2m-client-id
# AUTH0_MANAGEMENT_CLIENT_SECRET=your-server-m2m-client-secret
# Approved connection IDs for newly created organizations (not connection names).
# Without this list, membership discovery works but organization creation is disabled.
# AUTH0_ORGANIZATION_CONNECTION_IDS=con_exampleGoogle,con_exampleGitHub

# Optional administrator-managed Auth0 Organizations registry; use an absolute path.
# Leave unset if no seeded company entries are needed; discovered organizations use gateway state.
# Replace example organization IDs before enabling.
# THREATLINT_COMPANIES_FILE=/etc/threatlint-web/companies.json

# Persist this directory and all profile Docker volumes across restarts.
# Use an absolute service-owned path for production (for example /var/lib/threatlint-web).
THREATLINT_WEB_STATE_DIR=./.web-state
THREATLINT_PROFILE_MODE=docker
THREATLINT_PROFILE_IMAGE=threatlint-profile:local
THREATLINT_PROFILE_NAMESPACE=threatlint-production
THREATLINT_MAX_PROFILES=8
# Optional company administrator bootstrap: verified Auth0 subjects, comma separated.
# Alternatively issue the verified https://threatlint.dev/roles claim with administrator.
# THREATLINT_ADMIN_SUBJECTS=google-oauth2|example-subject
THREATLINT_WEB_HOST=127.0.0.1
PORT=3000
