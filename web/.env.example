# Public Auth0 SPA configuration. No client secret is used by this flow.
AUTH0_DOMAIN=threatlint.us.auth0.com
AUTH0_CLIENT_ID=eysUAb8yPNapU4TXqRHpIfhSX4xC4Qqy
AUTH0_AUDIENCE=https://threatlint.dev/api
THREATLINT_WEB_ORIGIN=https://threatlint.dev

# Optional overrides when social connections have different names in your tenant.
AUTH0_GOOGLE_CONNECTION=google-oauth2
AUTH0_APPLE_CONNECTION=apple
AUTH0_GITHUB_CONNECTION=github

# Persist this directory and all profile Docker volumes across restarts.
# Use an absolute service-owned path for production (for example /var/lib/threatlint-web).
THREATLINT_WEB_STATE_DIR=./.web-state
THREATLINT_PROFILE_MODE=docker
THREATLINT_PROFILE_IMAGE=threatlint-profile:local
THREATLINT_PROFILE_NAMESPACE=threatlint-production
THREATLINT_MAX_PROFILES=8
THREATLINT_WEB_HOST=127.0.0.1
PORT=3000
